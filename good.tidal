-- dreamy oscilating beeps, think Purno de Purno dream sequence
d1 $ jux (# nudge (choose [0.15, 0.2, 0.3, 0.1])) $ slow 2 $ every 4 (off (1/14) (|+ n 5))
   $ echo 4 "{-0.20,0.2}" 0.90
   $ sound "arpy" <| n "1(5,8,<0 2>)" # note "<a4 <c4 g4>>"
   # leslie (segment 32 (range 0 1.8 (slow 3 sine)))
   # room 0.6
   # sz 0.8
   # gain 0.8
   # krush 1
   # speed "<1,<1.5 2.0>>"
   # lpf (segment 8 (range 400 1700 (slow 2 sine)))
   # lpq (slow 3.3 (range 0.03 0.28 cosine))


