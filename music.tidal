d1 $ silence

d2 $ every 3 (|+ n "3") $ n "1*2 [4 3] [~ 3]*2 9 7" # sound "cpu2"
d2 $ silence

d3 $ every 3 (|* speed "0.9 0.8 0.7") $ every 4 (# sound "superpiano") $ off "f" (|+ n "7") $ arpeggiate $ note "<f4'min'4 g4'min'4>" # sound "fm:14" # legato 0.8

d4 $ loopAt 2 $ chop "256" $ sound "noisia_loop:1"
    # lpf "[20000 100 10000 300]!8"

d1 $ every 3 (|+ n "[1 3] [~ 4] 9 8") $ every 4 (|* speed 1.3) $ stack
   [ sound "kick kick snare [snare noisia:10]"
   , sound "hc hc hc*2 [ho ho]"
   , sound "bshihat:1(5,8) bshihat:2(5,8)"
   ]

d8 $ 0.125 <~ (slow 2 $ every 2 (# vowel "f") $ sound "laser laser laser*2 laser*7" # gain "1.2 1.0 0.8 0.7" # room 0.7 # sz 0.6 # dry 0.7 # lpf 2000)

d3 $ every 4 (|* speed 1.2) $ slow 2 $ splice 8 "4 <0 1 2 3 4>" $ sound "bsvocals:1" # room 0.8 # sz 0.5 # gain 0.8

d7 $ degradeBy 0.4 $ off "e" (|* speed "1.7") $ "0 1 2 3" # sound "alphabet:0 alphabet:1" # djf (slow 3 sine)


d8 $ slow 5 $ slice 6 "0*4" $ sound "funny"

solo 1
once $ sound "funny" # speed 1.0 # gain 1 # krush 3
unsolo 1

once $ sound "baa:4" # gain 1.5


d3 $ every 3 (off "e" id) $ sound "dbass*4" # krush 2 # gain 1.1

d2 $ loopAt 2 $ sound "noisia_loop:2"

d1 $ jux rev $ sometimes (\p -> p # sound "cpu2" |* gain 1.2) $ off "e" (|+ n "7") $ (scale "<minor pentatonic>" (cat ["1 2 3 4", "1 2 3 4", "2 4 5 6", "2 4 5 6"])) # sound "superpiano" |- n "7"
   # krush 3
   |*| speed "<0.8 1.2 0.6>"

d9 $ n "<1 2 3 4>" # sound "baa"


d1 $ cat
   [ note "g6 b6 d6 f6'sharp"
   , note "g7 f6'sharp d6 b6"
   , note "g6"
   ]
   # sound "superpiano"

setcps 0.4
d1 $ n "c5 e5 g5 b4 c5 e5 g4 e4 d4" # s "superpiano" # legato 1.2
d2 $ n "<g3 b3 d4>" # s "superpiano" # sustain 2 # gain 0.7 # cut 1

setcps (150/60/4)

xmas p = splice 256 p (sound "songs:0")





once $ slice 32 "6" $ sound "songs:0" # gain 0.8

d1 $ stack
   [ "{kick:4,hc} hc {snare,hc} hc"
   , n "3(5,8) [~ 8]*2" # sound "bshihat"
   ]
   # krush 3

d2 $ note "f4 <f5 f5'sharp c5>"
