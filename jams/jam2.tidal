-- Welcome to the second jam!
-- Today we got some vintage drum samples for the soul to play with!

d2 $ sew "t f t t"
   ( stack
     [ n "0 1 0 1"
     , n "8 9 10 11*<1 1 2 1>"
     , n "5*8"
     , every 4 ghost $ n "<14 15>(5,8,<0 2>)"
     , 0.125 <~ n (cat ["6 4 6 4", "4 11 4 12"])
     ] # sound "Rhythm-Ace"
   )
   (sound "bshihat*16")

d1 $ note "<d3 g3>"
   # sound "superhammond"
   # legato 0.3

d3 $ chunk 4 (iter 4)
   $ every 2 (# speed "{1,1.5}")
   $ note (scale "majPent" "{0 [3 5] [~ 7] 10}%8")
   |- note 12
   # sound "supermandolin"
   # gain 1.3

d4 $ sound "foley:0"
   # grain 0.1 (every 2 (const 1.0) 0.7)
   # room 0.5
   # lpf 1800
   # lpq 0.1

-- we need some progression...
-- back to my old friend rash hehe
d5 $ every 3 (arpeggiate)
   $ every 2 (|+ n 5)
   $ n "a1'maj c1'maj d1'maj e1'maj" # sound "rash"
   # lpf (segment 64 (range 1400 2800 (slow 4.2 sine)))

d6 $ note "c4 f4" # sound "vocals:0" # grain 0 0.07

-- I'm pretty tired today, inspiration is low :(
-- think I might safe face and end it here...
-- Let's at least go out the way of the DJ...

hush >> once (n (run 4) # sound "backspin")


