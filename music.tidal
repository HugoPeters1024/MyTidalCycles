d4 $ slow 2 $ echo 4 "{-0.2,0.2}" 0.9 $ note "a1 c1" # sound "laser"
   # pan (sine)

hush >> once (sound "funny:0")

d1 $ stack
   [ sound "kick:4 [~ noisia:10] kick:4 noisia:10*2"
   , sound "hc*8"
   ]
   # krush 1

d2 $ jux (# nudge 0.07) $ slow 2 $ note "~ ~ g5*<1 2> a5" # sound "noisia:0" # room 0.6 # krush 1 # sz 0.8 # lpf 1500 # speed 2 # gain 0.9

d3 $ n "d3(3,8) f2(<3 5>,8, <0 2>)" # sound "rash"

d3 $ slow 2 $ off (1/16) (|+ n 12)
   $ off (1/8) (|+ n 5)
   $ n "[d1(3,8) f1(3,8) e1(3,8,2) a2(3,8,2)]/2" # sound "arpy"
   # lpf 400
   # lpq 0.3

d4 $ slow 2 $ striate 2 $ splice 16 "2 1 5 7" $ sound "bsvocals:1" # leslie 1 # gain 0.5

d1 $ striate 2 $ jux rev $ note "[a c3/2] [a g] [~ c] <c d>" # sound "fm:14" # legato 0.5

d1 (loopAt 1 "breaks125")


d1 $ note "d4 <f4 a5>(3,8)" # sound "funny:1" # begin 0.3 # end 0.6 # lpf 900 # lpq (range 0.0 0.5 (slow 3 sine)) # room 0.7

d1 $ slice 8 (segment 1 (irand 8)) $ sound "funny:2" # lpf 1500 # lpq 0.3 # room 1 # sz 0.90

d1 $ splice 8 "1 2 3 4" $ sound "funny:0"

d1 $ fast 2 $ sew "t(5,8, <0 2>)" (sound "kick:4 noisia:10 kick:4 [~ noisia:10]" # krush 1) (n (run 8) # sound "cpu2")
d2 $ every 2 (struct "t(5,8)") $ sound "hc*8" # krush 1

d3 $ fast 2 $ off (1/4) (|+ note 12) $ off (1/2) (|+ note 5) $ note "<b5'min'2 <f5'min'2 c5'maj'2> d5'maj'2 a5'maj'<2 3>>/2" # sound "superpiano"
   # lpf 1700
   # lpfbus 1 (segment 256 $ range 10 1700 (fast 4 saw))
   # legato 1.5
   # gain 1.2
   # lpq (range 0 0.3 (slow 2.3 sine))

d4 $ slow 2 $ note "f3 [~ f4] [<f3 ~> f3] f4*<1 2>" # sound "noisia:0" # cut 1 # leslie 1

hush >> once (n (run 8) # sound "backspin") >> d1 (n "10 10 [~ 10] 10" # sound "noisia:10") >> d2 (n "d3(3,8) f2(5,8,<0 2>)" # sound "rash")

hush >> once (sound "sax") >> hush

d1 $ struct "t(13,28) t(17,23)"
   $ sound "super808 arpy"
   # rate (segment 16 (range 0 0.7 (fast 2 sine)))
   # voice (segment 16 (range 0.3 1.0 (slow 2.3 cosine)))

d1 $ n "60*10" # sound "superstatic"

d1 $ n "[d1(3,8) f1(3,8) e1(3,8,2) a1(3,8,2)]/2" # sound "rash"

d1 $ sound "super808*4"

d2 $ off (1/16) (|+ n 7) $ n "[d1(5,8) f1(5,8) g1(5,8) d1(5,8)]/2" # sound "rash"
   # lpf 1200
   # lpq (segment 8 (slow 3 (range 0 0.7 sine)))

d3 $ slice 8 (segment 1 (irand 7)) $ sound "fm:17" # room 0.7 # sz 0.3 # gain 0.7

d4 $ arpeggiate $ note "c4'maj" # sound "funny:3" # gain 1.3 # cut 1


d5 $ arpeggiate $ note "c'maj'3 a'min'3 f'maj'4" # sound "superpiano"

d1 $ every 4 (fast 4) $ sound "super808*4"

d2 $ chunk 4 (iter 4) $ sound "4 7 [8 9] 1" # sound "cpu2" # gain 1.2

d3 $ off (1/16) (|+ n 5)
   $ n (segment 8 (range 0 7 (fast 4 perlin))) # sound "arpy"


d3 $ every 2 (arpeggiate)
   $ note "{c5'maj g5'maj e5'min a5'maj}/2"
   # sound "superpiano" # gain 1.1
   # room 1
   # lpf 1200
   # lpq (segment 32 (range 0.0 0.3 (slow 3.4 sine)))

d4 $ off (1/8) (\p -> p |+ n 5 # gain 0.8)
   $ n "d1(5,8) <f0 f1>(5,8,<0 2>)" # sound "rash"

d2 $ loopAt 2 $ sound "noisia_loop:2"

setcps (178/60/4)

d3 $ n "0 0 0 0*<1 1 1 2>" # sound "super808" # distort 1

d4 $ sound "super808*4" # lpf 200

d1 $ sound "snare*4" # legato 0.1

d2 $ sound "~ ho ~ ho"

d5 $ sound "hc*8"

d6 $ 0.125 <~ (slow 2
   $ chunk 4 (hurry 2)
   $ note "1 2 [3 4] 5"
   # sound "cs80lead" # legato 0.1 # room 0.78 |+ note 24 # gain 0.8
   # pF "dtune" (segment 8 (range 0 0.3 (slow 3 cosine)))
   # speed "1"
   |+ n (irand 7))

d7 $ sound "funny:3/8" # gain 1.5 # cut 1 # room 1 # sz 0.95
d7 silence

d1 $ qt $ loopAt 2 $ sound "noisia_loop:1"

d8 $ 0.25 <~ sound "kick:4*2"
d7 $ sound "snare:2"

d3 $ n "{5,2} 5 {5,11} 5" # sound "Rhythm-Ace"

d2 $ note "c4'maj" # sound "supermandolin" # gain 1.4

d1 $ chunk 4 (iter 4) $ voice "0 0.8 [0 0.3] 0.6" # sound "super808"

d2 $ note "<c2 f2 g2 e2>" # sound "cs80lead" |+ note "{36,37,38,39,52}" # lpfbus 1 (segment 256 (range 0 200 (fast 13 sine)))

d3 $ stack [
    note "c'min7 f'maj7 g'min7 eb'maj7" # s "superpiano",
    note "c2 f2 g2 eb2" # s "superpiano"
] # gain 0.8 # room 0.5 # lpf 200

d3 $ note "<f3'min'2 ~ g3 a3>*2" # sound "superpiano" |+ n "{0,5,12}"

d1 $ slow 8 $ n (run 32) # sound "foley"







