  # gain 1.34

unsolo 2

d1 $ every 4 (|+| n "1 2 3 4") $ fast 2 $ sound "{kick:3,hc} hc {snare,hc} <hc hc hc [ho ho]>" # gain 0.8

unsolo 5

solo 2
unsolo 2

d3 $ every 2 (off "e" (|+ n "1")) $ sound "dbass dbass [~ dbass] dbass" # gain 0.8

all (# djf 0.3)
all id

d4 $ fast 2 $ note "<f5 f6 _ f7 _ _>" # sound "fm:14" # room 0.8 # sz 0.4 # gain 0.8 # djf 0.2

unsolo 5

